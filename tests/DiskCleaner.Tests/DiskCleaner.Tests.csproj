<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DiskCleaner.Core\DiskCleaner.Core.csproj" />
    <ProjectReference Include="..\..\src\DiskCleaner.Elevated\DiskCleaner.Elevated.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\DiskCleaner.Cli\DiskCleaner.Cli.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyElevatedExeForTests" AfterTargets="Build">
    <ItemGroup>
      <_ElevatedOutput Include="$(MSBuildProjectDirectory)\..\..\src\DiskCleaner.Elevated\bin\$(Configuration)\net8.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ElevatedOutput)"
          DestinationFolder="$(OutDir)Elevated\%(RecursiveDir)"
          Condition="Exists('%(FullPath)')" />
  </Target>

  <Target Name="CopyCliExeForTests" AfterTargets="Build">
    <ItemGroup>
      <_CliOutput Include="$(MSBuildProjectDirectory)\..\..\src\DiskCleaner.Cli\bin\$(Configuration)\net8.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CliOutput)"
          DestinationFolder="$(OutDir)Cli\%(RecursiveDir)"
          Condition="Exists('%(FullPath)')" />
  </Target>

</Project>
