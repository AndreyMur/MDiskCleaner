<Window x:Class="DiskCleaner.Gui.LeftoverScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/DiskCleaner;component/Assets/DiskCleaner.ico"
        xmlns:converters="clr-namespace:DiskCleaner.Gui.Converters"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Title="Остатки удалённых программ"
        Height="800" Width="1240"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:RiskToBrushConverter x:Key="RiskBrushConverter" />

        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackgroundBrush}" Padding="10,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="{Binding SelectedSummary}" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Найти остатки"
                            Command="{Binding ScanCommand}"
                            ToolTip="Поиск остатков удалённых программ: реестр Uninstall + верхние уровни каталогов. Кандидаты выключены по умолчанию (FR-3.8)." />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Предпросмотр (dry-run)"
                            Command="{Binding PreviewDryRunCommand}"
                            ToolTip="Показать, что будет удалено для отмеченных остатков (с повторной проверкой процессов/%PATH%/служб). Ничего не удаляется (FR-3.8)." />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Удалить отмеченное"
                            Command="{Binding ExecuteCommand}"
                            ToolTip="Запросить подтверждение (включая админ-шаги с одним UAC-подъёмом) и выполнить удаление отмеченных остатков." />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Исключения…"
                            Click="ExclusionsButton_Click"
                            ToolTip="Открыть список исключений пользователя: просмотр, добавление и удаление записей по пути или бренду (FR-3.7)." />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Отмена"
                            Command="{Binding CancelCommand}"
                            ToolTip="Отменить текущую операцию (сканирование/удаление)." />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Margin="10,8,10,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   Text="{Binding ContextText}" />

        <Border DockPanel.Dock="Top"
                Margin="10,6,10,0"
                Padding="10,6"
                Background="{StaticResource WarningBackgroundBrush}"
                BorderBrush="{StaticResource WarningBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding WarningsText}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource WarningBrightTextBrush}" />
        </Border>

        <Border DockPanel.Dock="Top"
                Margin="10,6,10,0"
                Padding="10,6"
                Background="{StaticResource InfoBackgroundBrush}"
                BorderBrush="{StaticResource InfoBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Visibility="{Binding HasExclusions, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding ExclusionsSummary}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource InfoTextBrush}" />
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Margin="10,8,10,0"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Text="План остатков"
                   Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibilityConverter}}" />

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Grid DockPanel.Dock="Bottom" Height="46"
              Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding ProgressText}" Margin="10,4,10,0"
                       TextTrimming="CharacterEllipsis" />
            <ProgressBar Grid.Row="1" Height="10" Margin="10,4,10,4"
                         IsIndeterminate="True" />
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="True"
                                  Margin="0,0,0,8"
                                  Padding="4"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  BorderThickness="1">
                            <Expander.Header>
                                <Grid Margin="2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              VerticalAlignment="Center"
                                              IsThreeState="True"
                                              IsEnabled="{Binding CanBulkCheck}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              ToolTip="Отметить/снять остатки группы без обязательного подтверждения. Опасные объекты (Program Files/ProgramData/Windows.old) отмечаются по одному с подтверждением." />

                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14" />
                                            <TextBlock Text="{Binding SelectedText}"
                                                       Margin="10,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource SuccessTextBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource WarningBrightTextBrush}"
                                                   FontSize="12" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBodyBrush}"
                                               FontSize="12"
                                               Text="{Binding SummaryText}" />
                                </Grid>
                            </Expander.Header>

                            <ItemsControl ItemsSource="{Binding Items}" Margin="12,4,4,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource SubtleBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          VerticalAlignment="Top"
                                                          Margin="0,2,10,0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding LabelsText}"
                                                                   Visibility="{Binding HasLabels, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                   Margin="8,2,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource WarningTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,2">
                                                        <Run Text="Путь: " FontWeight="SemiBold" />
                                                        <Run Text="{Binding PathText, Mode=OneWay}" />
                                                    </TextBlock>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                                                   Visibility="{Binding HasFileCount, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Run Text="Файлов: " FontWeight="SemiBold" />
                                                            <Run Text="{Binding FileCountText, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                                                   Margin="12,0,0,0"
                                                                   Visibility="{Binding HasLastWrite, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Run Text="Изменён: " FontWeight="SemiBold" />
                                                            <Run Text="{Binding LastWriteText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,2"
                                                               Foreground="{StaticResource TextBodyBrush}">
                                                        <Run Text="Почему это остаток: " FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <Run Text="{Binding ReasonText, Mode=OneWay}" />
                                                    </TextBlock>

                                                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,2"
                                                               Foreground="{StaticResource WarningTextBrush}"
                                                               Visibility="{Binding HasRecommendedRemovalMethod, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Run Text="Рекомендуется удалить: " FontWeight="SemiBold" />
                                                        <Run Text="{Binding RecommendedRemovalMethod, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Top" Width="170">
                                                    <TextBlock Text="{Binding SizeText}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding RiskText}"
                                                               Margin="0,3,0,0"
                                                               FontSize="11"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{Binding Risk, Converter={StaticResource RiskBrushConverter}}" />
                                                    <Button Content="В исключения"
                                                            Height="24"
                                                            Margin="0,8,0,0"
                                                            Padding="8,0"
                                                            FontSize="11"
                                                            HorizontalAlignment="Right"
                                                            ToolTip="Не предлагать этот остаток в будущих сканах: по пути или по имени/бренду (FR-3.7)."
                                                            Command="{Binding DataContext.AddExclusionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
