<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>12</LangVersion>
    <RootNamespace>DiskCleaner.Gui</RootNamespace>
    <AssemblyName>DiskCleaner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DiskCleaner.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\DiskCleaner.ico" />
    <Resource Include="Assets\DiskCleaner_256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiskCleaner.Core\DiskCleaner.Core.csproj" />
    <ProjectReference Include="..\DiskCleaner.Elevated\DiskCleaner.Elevated.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyElevatedExe" AfterTargets="Build">
    <ItemGroup>
      <_ElevatedOutput Include="$(MSBuildProjectDirectory)\..\DiskCleaner.Elevated\bin\$(Configuration)\net8.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ElevatedOutput)"
          DestinationFolder="$(OutDir)Elevated\%(RecursiveDir)"
          Condition="Exists('%(FullPath)')" />
  </Target>

</Project>
