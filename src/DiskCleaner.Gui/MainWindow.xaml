<Window x:Class="DiskCleaner.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DiskCleaner.Gui.Converters"
        xmlns:viewModels="clr-namespace:DiskCleaner.Gui.ViewModels"
        Title="DiskCleaner — анализ, остатки и деинсталляция"
        Height="760" Width="1240"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:LongToSizeTextConverter x:Key="SizeTextConverter" />
        <converters:CategoryToTextConverter x:Key="CategoryTextConverter" />
        <converters:RiskToTextConverter x:Key="RiskTextConverter" />
        <converters:RiskToBrushConverter x:Key="RiskBrushConverter" />
        <converters:BoolToInUseTextConverter x:Key="InUseTextConverter" />
        <converters:BoolToInUseBrushConverter x:Key="InUseBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:YesNoTextConverter x:Key="YesNoTextConverter" />

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F3F3F3" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Анализ"
                            Command="{Binding AnalyzeCommand}" />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Выполнить план"
                            Command="{Binding CleanCommand}" />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Отмена"
                            Command="{Binding CancelCommand}" />
                    <CheckBox Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              FontSize="13"
                              Content="Предпросмотр (dry-run)"
                              IsChecked="{Binding DryRun}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="{Binding SelectedSummary}" />
            </DockPanel>
        </Border>

        <Grid DockPanel.Dock="Bottom" Height="46"
              Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding ProgressText}" Margin="10,4,10,0"
                       TextTrimming="CharacterEllipsis" />
            <ProgressBar Grid.Row="1" Height="10" Margin="10,4,10,4"
                         IsIndeterminate="{Binding IsProgressIndeterminate}" />
        </Grid>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding FreeSpaceText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*" MinWidth="420" />
                <ColumnDefinition Width="1.2*" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                           Text="Категории и объекты очистки" />
                <TreeView x:Name="CategoryTree"
                          ItemsSource="{Binding RootNodes}"
                          SelectedItemChanged="OnTreeSelectionChanged"
                          BorderBrush="#DDDDDD">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type viewModels:TreeItemViewModel}"
                                                  ItemsSource="{Binding Children}">
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          VerticalAlignment="Center"
                                          IsThreeState="True"
                                          IsEnabled="{Binding CanCheck}"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}" />

                                <TextBlock Grid.Column="1"
                                           Margin="6,0,8,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Item.DisplayName}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <StackPanel MaxWidth="460">
                                            <TextBlock Text="{Binding Item.Description}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Item.Warning}"
                                                       TextWrapping="Wrap" Foreground="#B46A00" />
                                        </StackPanel>
                                    </TextBlock.ToolTip>
                                </TextBlock>

                                <TextBlock Grid.Column="2"
                                           Margin="4,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Text="{Binding Item.Risk, Converter={StaticResource RiskTextConverter}}"
                                           Foreground="{Binding Item.Risk, Converter={StaticResource RiskBrushConverter}}" />

                                <TextBlock Grid.Column="3"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding Item.EffectiveSizeBytes, Converter={StaticResource SizeTextConverter}}" />

                                <TextBlock Grid.Column="4"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{Binding Item.InUse, Converter={StaticResource InUseBrushConverter}}"
                                           Text="{Binding Item.InUse, Converter={StaticResource InUseTextConverter}}" />
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <DockPanel Grid.Column="1">
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                               Text="Сведения об объекте" />
                    <ScrollViewer DockPanel.Dock="Top" MaxHeight="210" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedNode.Item.DisplayName}"
                                       FontSize="14" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Категория:" Foreground="#666666" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="6,0,0,2"
                                           Text="{Binding SelectedNode.Item.Category, Converter={StaticResource CategoryTextConverter}}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Риск:" Foreground="#666666" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="6,0,0,2"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedNode.Item.Risk, Converter={StaticResource RiskTextConverter}}"
                                           Foreground="{Binding SelectedNode.Item.Risk, Converter={StaticResource RiskBrushConverter}}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Требует админ:" Foreground="#666666" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="6,0,0,2"
                                           Text="{Binding SelectedNode.Item.RequiresAdmin, Converter={StaticResource YesNoTextConverter}}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Размер:" Foreground="#666666" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="6,0,0,2"
                                           Text="{Binding SelectedNode.Item.EffectiveSizeBytes, Converter={StaticResource SizeTextConverter}}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Команда:" Foreground="#666666" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="6,0,0,2"
                                           Text="{Binding SelectedNode.Item.CleanCommand}"
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Путь:" Foreground="#666666" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Margin="6,0,0,2"
                                           Text="{Binding SelectedNode.Item.Path}"
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Примечание:" Foreground="#666666" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Margin="6,0,0,2"
                                           Text="{Binding SelectedNode.Item.Warning}"
                                           Foreground="#B46A00"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                           Margin="0,10,0,6"
                           Text="План (выбранные объекты)" />

                <DataGrid ItemsSource="{Binding PlanRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#DDDDDD"
                          RowHeaderWidth="0"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Объект" Width="1.6*" Binding="{Binding Name}" />
                        <DataGridTextColumn Header="Риск" Width="64" Binding="{Binding Risk}" />
                        <DataGridTextColumn Header="Размер" Width="84" Binding="{Binding Size}" />
                        <DataGridTextColumn Header="Админ" Width="52" Binding="{Binding AdminText}" />
                        <DataGridTextColumn Header="Команда" Width="1.8*" Binding="{Binding Command}" />
                        <DataGridTextColumn Header="Путь" Width="2*" Binding="{Binding Path}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
