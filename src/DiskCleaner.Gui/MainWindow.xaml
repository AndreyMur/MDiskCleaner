<Window x:Class="DiskCleaner.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DiskCleaner.Gui.Converters"
        xmlns:viewModels="clr-namespace:DiskCleaner.Gui.ViewModels"
        Title="DiskCleaner — анализ, остатки и деинсталляция"
        Height="760" Width="1280"
        MinHeight="560" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">

    <Window.Resources>
        <converters:LongToSizeTextConverter x:Key="SizeTextConverter" />
        <converters:CategoryToTextConverter x:Key="CategoryTextConverter" />
        <converters:RiskToTextConverter x:Key="RiskTextConverter" />
        <converters:RiskToBrushConverter x:Key="RiskBrushConverter" />
        <converters:BoolToInUseTextConverter x:Key="InUseTextConverter" />
        <converters:BoolToInUseBrushConverter x:Key="InUseBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:YesNoTextConverter x:Key="YesNoTextConverter" />
        <converters:ChangeKindToBrushConverter x:Key="ChangeKindBrushConverter" />

        <Style x:Key="ComparisonKindCell" TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{Binding ChangeKind, Converter={StaticResource ChangeKindBrushConverter}}" />
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F3F3F3" Padding="10,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Анализ"
                            Command="{Binding AnalyzeCommand}" />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Выполнить план"
                            Command="{Binding CleanCommand}" />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Очистка кэшей"
                            Command="{Binding OpenCacheCleanCommand}"
                            ToolTip="Открыть экран «Очистка кэшей»: группы кэшей по менеджеру/приложению, отметка чекбоксами, dry-run-предпросмотр, выполнение с прогрессом и отчёт (FR-2.1–2.12)." />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Остатки"
                            Command="{Binding OpenLeftoverScanCommand}"
                            ToolTip="Открыть экран «Остатки удалённых программ»: группы остатков с основаниями, включение чекбоксами (по умолчанию выключено), пообъектное подтверждение опасных объектов, dry-run и исключения (FR-3.2–3.8)." />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Деинсталляция"
                            Command="{Binding OpenUninstallerCommand}"
                            ToolTip="Открыть экран «Деинсталляция и зачистка»: список ПО с колонками и пометками (дубли/старые версии/«Проверить вручную»), выбор без предвыбора, пошаговое подтверждение, массовое удаление Windows SDK, осиротевшие записи Uninstall (FR-4.1–4.13)." />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Отмена"
                            Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Расписание"
                            Command="{Binding OpenSchedulerCommand}" />
                    <ComboBox Width="128"
                              Height="30"
                              Margin="14,0,8,0"
                              VerticalContentAlignment="Center"
                              FontSize="13"
                              ItemsSource="{Binding ExportFormats}"
                              SelectedItem="{Binding SelectedExportFormat}"
                              DisplayMemberPath="DisplayName"
                              ToolTip="Формат экспорта плана очистки (Markdown/JSON/CSV, FR-1.12)." />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Экспорт"
                            Command="{Binding ExportCommand}"
                            ToolTip="Сохранить план текущего анализа в выбранном формате." />
                </StackPanel>

                <CheckBox Grid.Row="0" Grid.Column="1"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          FontSize="13"
                          Content="Предпросмотр (dry-run)"
                          IsChecked="{Binding DryRun}" />

                <StackPanel Grid.Row="1" Grid.Column="0"
                            Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Источник:" VerticalAlignment="Center"
                               FontSize="13" Margin="0,0,6,0" />
                    <ComboBox Width="400"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Sources}"
                              SelectedItem="{Binding SelectedSource}"
                              IsEnabled="{Binding CanChangeSource}"
                              DisplayMemberPath="DisplayName"
                              ToolTip="Выберите диск для полного скана или режим «известные объекты» профиля/реестра/системы." />
                    <CheckBox Margin="14,0,0,0"
                              VerticalAlignment="Center"
                              FontSize="13"
                              Content="Включить системные каталоги (Windows и др.)"
                              IsChecked="{Binding IncludeSystemDirectories}"
                              IsEnabled="{Binding IsSystemDirectoriesToggleEnabled}"
                              ToolTip="По умолчанию системные каталоги (Windows, System Volume Information, $Recycle.Bin, WindowsApps) игнорируются при полном скане диска (FR-1.2)." />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="12,6,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="{Binding SelectedSummary}" />
            </Grid>
        </Border>

        <Grid DockPanel.Dock="Bottom" Height="46"
              Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding ProgressText}" Margin="10,4,10,0"
                       TextTrimming="CharacterEllipsis" />
            <ProgressBar Grid.Row="1" Height="10" Margin="10,4,10,4"
                         IsIndeterminate="{Binding IsProgressIndeterminate}" />
        </Grid>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding FreeSpaceText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*" MinWidth="430" />
                <ColumnDefinition Width="1.2*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                           Text="Категории и объекты очистки" />
                <TreeView x:Name="CategoryTree"
                          ItemsSource="{Binding RootNodes}"
                          SelectedItemChanged="OnTreeSelectionChanged"
                          BorderBrush="#DDDDDD">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type viewModels:TreeItemViewModel}"
                                                  ItemsSource="{Binding Children}">
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          VerticalAlignment="Center"
                                          IsThreeState="True"
                                          IsEnabled="{Binding CanCheck}"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}" />

                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Margin="6,0,8,0"
                                           Text="{Binding Item.DisplayName}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <StackPanel MaxWidth="460">
                                            <TextBlock Text="{Binding Item.Description}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Item.Warning}"
                                                       TextWrapping="Wrap" Foreground="#B46A00" />
                                        </StackPanel>
                                    </TextBlock.ToolTip>
                                </TextBlock>

                                <TextBlock Grid.Column="2"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="#888888"
                                           Text="{Binding CategoryObjectsText}" />

                                <TextBlock Grid.Column="3"
                                           Margin="4,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Text="{Binding Item.Risk, Converter={StaticResource RiskTextConverter}}"
                                           Foreground="{Binding Item.Risk, Converter={StaticResource RiskBrushConverter}}" />

                                <TextBlock Grid.Column="4"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding Item.EffectiveSizeBytes, Converter={StaticResource SizeTextConverter}}" />

                                <TextBlock Grid.Column="5"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{Binding Item.InUse, Converter={StaticResource InUseBrushConverter}}"
                                           Text="{Binding Item.InUse, Converter={StaticResource InUseTextConverter}}" />
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <DockPanel Grid.Column="1">
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                               Text="Сведения об объекте" />
                    <ScrollViewer DockPanel.Dock="Top" MaxHeight="210" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedNode.Item.DisplayName}"
                                       FontSize="14" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Категория:" Foreground="#666666" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="6,0,0,2"
                                           Text="{Binding SelectedNode.Item.Category, Converter={StaticResource CategoryTextConverter}}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Риск:" Foreground="#666666" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="6,0,0,2"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedNode.Item.Risk, Converter={StaticResource RiskTextConverter}}"
                                           Foreground="{Binding SelectedNode.Item.Risk, Converter={StaticResource RiskBrushConverter}}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Требует админ:" Foreground="#666666" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="6,0,0,2"
                                           Text="{Binding SelectedNode.Item.RequiresAdmin, Converter={StaticResource YesNoTextConverter}}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Размер:" Foreground="#666666" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="6,0,0,2"
                                           Text="{Binding SelectedNode.Item.EffectiveSizeBytes, Converter={StaticResource SizeTextConverter}}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Команда:" Foreground="#666666" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="6,0,0,2"
                                           Text="{Binding SelectedNode.Item.CleanCommand}"
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Путь:" Foreground="#666666" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Margin="6,0,0,2"
                                           Text="{Binding SelectedNode.Item.Path}"
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Примечание:" Foreground="#666666" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Margin="6,0,0,2"
                                           Text="{Binding SelectedNode.Item.Warning}"
                                           Foreground="#B46A00"
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Метки:" Foreground="#666666" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Margin="6,0,0,2"
                                           Text="{Binding SelectedNode.Item.InUse, Converter={StaticResource InUseTextConverter}}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0"
                            Visibility="{Binding HasComparison, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                               Text="Было/стало (сравнение с предыдущим сканом)" />
                    <TextBlock Margin="0,0,0,4"
                               Text="{Binding ComparisonSummary}"
                               TextWrapping="Wrap"
                               Foreground="#444444" />
                    <DataGrid ItemsSource="{Binding ComparisonRows}"
                              MaxHeight="150"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="#DDDDDD"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Объект" Width="1.2*" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Категория" Width="0.9*" Binding="{Binding Category}" />
                            <DataGridTextColumn Header="Было" Width="72" Binding="{Binding Was}" />
                            <DataGridTextColumn Header="Стало" Width="72" Binding="{Binding Now}" />
                            <DataGridTextColumn Header="Δ" Width="84" Binding="{Binding Delta}" />
                            <DataGridTextColumn Header="Изменение" Width="92"
                                                Binding="{Binding ChangeText}"
                                                ElementStyle="{StaticResource ComparisonKindCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                           Margin="0,10,0,6"
                           Text="План (выбранные объекты)" />

                <DataGrid ItemsSource="{Binding PlanRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#DDDDDD"
                          RowHeaderWidth="0"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Объект" Width="1.5*" Binding="{Binding Name}" />
                        <DataGridTextColumn Header="Риск" Width="58" Binding="{Binding Risk}" />
                        <DataGridTextColumn Header="Размер" Width="84" Binding="{Binding Size}" />
                        <DataGridTextColumn Header="Админ" Width="48" Binding="{Binding AdminText}" />
                        <DataGridTextColumn Header="Действие" Width="86" Binding="{Binding DefaultActionText}" />
                        <DataGridTextColumn Header="Метки" Width="130" Binding="{Binding FlagsText}" />
                        <DataGridTextColumn Header="Команда" Width="1.5*" Binding="{Binding Command}" />
                        <DataGridTextColumn Header="Путь" Width="1.5*" Binding="{Binding Path}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
