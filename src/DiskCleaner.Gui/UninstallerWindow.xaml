<Window x:Class="DiskCleaner.Gui.UninstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/DiskCleaner;component/Assets/DiskCleaner.ico"
        xmlns:converters="clr-namespace:DiskCleaner.Gui.Converters"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Title="Деинсталляция и зачистка"
        Height="820" Width="1280"
        MinHeight="620" MinWidth="1020"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackgroundBrush}" Padding="10,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="{Binding SelectedSummary}" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Найти программы"
                            Command="{Binding ScanCommand}"
                            ToolTip="Чтение реестра Uninstall (три ветки) и построение плана деинсталляции с пометками (FR-4.1–4.4)." />
                    <ComboBox Width="260"
                              Height="30"
                              Margin="0,0,14,0"
                              VerticalContentAlignment="Center"
                              FontSize="13"
                              ItemsSource="{Binding FilterOptions}"
                              SelectedItem="{Binding SelectedFilter}"
                              DisplayMemberPath="DisplayName"
                              ToolTip="Фильтр списка: все программы / рекомендации (дубли и старые версии) / группа «Проверить вручную» (FR-4.2/4.3)." />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Удалить отмеченные"
                            Command="{Binding ExecuteCommand}"
                            ToolTip="Пообъектное подтверждение каждого шага с объёмом и названием (FR-4.11), затем исполнение пачки (один UAC-подъём для машинных веток)." />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Удалить версию SDK"
                            Command="{Binding RemoveSdkVersionCommand}"
                            ToolTip="Массовое удаление выбранной версии Windows SDK последовательно по GUID с прогрессом по компонентам (FR-4.7/4.8)." />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Осиротевшие записи"
                            Command="{Binding ExecuteOrphansCommand}"
                            ToolTip="Удалить отмеченные осиротевшие записи Uninstall из реестра (только ветки реестра, FR-4.13)." />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Отмена"
                            Command="{Binding CancelCommand}"
                            ToolTip="Отменить текущую операцию." />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Margin="10,8,10,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   Text="{Binding ContextText}" />

        <Border DockPanel.Dock="Top"
                Margin="10,6,10,0"
                Padding="10,6"
                Background="{StaticResource WarningBackgroundBrush}"
                BorderBrush="{StaticResource WarningBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding WarningsText}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource WarningBrightTextBrush}" />
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Grid DockPanel.Dock="Bottom" Height="46"
              Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding ProgressText}" Margin="10,4,10,0"
                       TextTrimming="CharacterEllipsis" />
            <ProgressBar Grid.Row="1" Height="10" Margin="10,4,10,4"
                         IsIndeterminate="True" />
        </Grid>

        <TabControl Margin="10,8,10,4">
            <TabItem Header="Установленные программы">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,6"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="Программы из реестра Uninstall (шаги плана деинсталляции)"
                               Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <DataGrid ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="{StaticResource BorderBrush}"
                              RowHeaderWidth="0"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Название" Width="1.4*" Binding="{Binding Title}" />
                            <DataGridTextColumn Header="Группа" Width="1.0*" Binding="{Binding GroupName}" />
                            <DataGridTextColumn Header="Издатель" Width="1.1*" Binding="{Binding PublisherText}" />
                            <DataGridTextColumn Header="Версия" Width="110" Binding="{Binding VersionText}" />
                            <DataGridTextColumn Header="Дата" Width="86" Binding="{Binding DateText}" />
                            <DataGridTextColumn Header="Размер (запись)" Width="100" Binding="{Binding SizeText}" />
                            <DataGridTextColumn Header="Занимает на C:" Width="110" Binding="{Binding SizeOnCDriveText}" />
                            <DataGridTextColumn Header="Путь" Width="1.8*" Binding="{Binding PathText}" />
                            <DataGridTextColumn Header="Пометки" Width="170" Binding="{Binding MarksText}" />
                            <DataGridTextColumn Header="Рекомендация" Width="1.2*" Binding="{Binding NoteText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Версии Windows SDK">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Top"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextBodyBrush}"
                               FontSize="12"
                               Text="{Binding SdkInstructionText}" />

                    <DockPanel DockPanel.Dock="Top" Margin="0,10,0,6">
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontSize="13"
                                   Text="Версия для массового удаления:" />
                        <ComboBox Width="420"
                                  Height="30"
                                  VerticalContentAlignment="Center"
                                  ItemsSource="{Binding SdkVersions}"
                                  SelectedItem="{Binding SelectedSdkVersion}"
                                  IsEnabled="{Binding HasSdkVersions}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding DisplayVersion}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding ComponentCountText}" />
                                        <Run Text=" · ~" />
                                        <Run Text="{Binding EstimatedTotalText}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,4"
                               FontSize="12"
                               Foreground="{StaticResource TextBodyBrush}"
                               Text="Компоненты выбранной версии:" />
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,8"
                               FontSize="12"
                               FontFamily="Consolas"
                               Text="{Binding SelectedSdkVersion.ComponentNamesText}"
                               TextWrapping="Wrap" />

                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,6,0,2"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="Журнал массового удаления (по компонентам):" />
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Padding="8"
                            MaxHeight="240">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SdkProgressLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="Осиротевшие записи Uninstall">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Top"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource WarningBrightTextBrush}"
                               FontSize="12"
                               Margin="0,0,0,6"
                               Text="Записи Uninstall, ссылающиеся на отсутствующие пути. Удаляется только ветка реестра (файлы не затрагиваются). Включение записи — с пообъектным подтверждением (FR-4.13)." />
                    <DataGrid ItemsSource="{Binding Orphans}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="{StaticResource BorderBrush}"
                              RowHeaderWidth="0"
                              IsReadOnly="True"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Название" Width="1.6*" Binding="{Binding Title}" />
                            <DataGridTextColumn Header="Ветка" Width="150" Binding="{Binding ScopeText}" />
                            <DataGridTextColumn Header="Что отсутствует" Width="2.4*" Binding="{Binding MissingPathsText}" />
                            <DataGridTextColumn Header="Системный компонент" Width="130" Binding="{Binding IsSystemComponent}" />
                            <DataGridTextColumn Header="Требует админ" Width="110" Binding="{Binding RequiresAdmin}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
