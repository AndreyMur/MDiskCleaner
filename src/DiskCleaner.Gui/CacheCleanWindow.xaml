<Window x:Class="DiskCleaner.Gui.CacheCleanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/DiskCleaner;component/Assets/DiskCleaner.ico"
        xmlns:converters="clr-namespace:DiskCleaner.Gui.Converters"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Title="Очистка кэшей"
        Height="760" Width="1180"
        MinHeight="560" MinWidth="940"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:RiskToBrushConverter x:Key="RiskBrushConverter" />

        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackgroundBrush}" Padding="10,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="{Binding SelectedSummary}" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Сформировать план"
                            Command="{Binding AnalyzeCommand}"
                            ToolTip="Быстрый анализ известных кэшей (фактический путь через команды менеджера) и составление плана очистки." />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Предпросмотр (dry-run)"
                            Command="{Binding PreviewDryRunCommand}"
                            ToolTip="Показать, что будет удалено для отмеченных кэшей. Ничего не удаляется." />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Выполнить очистку"
                            Command="{Binding ExecuteCommand}"
                            ToolTip="Запросить подтверждение и выполнить очистку отмеченных кэшей." />
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="Отмена"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Margin="10,8,10,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   Text="{Binding ContextText}" />

        <Border DockPanel.Dock="Top"
                Margin="10,6,10,0"
                Padding="10,6"
                Background="{StaticResource WarningBackgroundBrush}"
                BorderBrush="{StaticResource WarningBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding WarningsText}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource WarningBrightTextBrush}" />
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Margin="10,8,10,0"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Text="План очистки кэшей"
                   Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibilityConverter}}" />

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Grid DockPanel.Dock="Bottom" Height="46"
              Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding ProgressText}" Margin="10,4,10,0"
                       TextTrimming="CharacterEllipsis" />
            <ProgressBar Grid.Row="1" Height="10" Margin="10,4,10,4"
                         IsIndeterminate="True" />
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="True"
                                  Margin="0,0,0,8"
                                  Padding="4"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  BorderThickness="1">
                            <Expander.Header>
                                <Grid Margin="2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              VerticalAlignment="Center"
                                              IsThreeState="True"
                                              IsEnabled="{Binding CanBulkCheck}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              ToolTip="Отметить/снять объекты группы с автоматическим согласием. Объекты, требующие явного согласия, отмечаются по одному." />

                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14" />
                                            <TextBlock Text="{Binding SelectedText}"
                                                       Margin="10,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource SuccessTextBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource WarningBrightTextBrush}"
                                                   FontSize="12" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBodyBrush}"
                                               FontSize="12"
                                               Text="{Binding SummaryText}" />
                                </Grid>
                            </Expander.Header>

                            <ItemsControl ItemsSource="{Binding Actions}" Margin="12,4,4,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource SubtleBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          VerticalAlignment="Top"
                                                          Margin="0,2,10,0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding IsSelectable}" />

                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,3">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding LabelsText}"
                                                                   Margin="8,2,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource WarningTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,2">
                                                        <Run Text="Путь: " FontWeight="SemiBold" />
                                                        <Run Text="{Binding PathText, Mode=OneWay}" />
                                                    </TextBlock>

                                                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,2">
                                                        <Run Text="Способ: " FontWeight="SemiBold" />
                                                        <Run Text="{Binding MethodText, Mode=OneWay}" />
                                                    </TextBlock>

                                                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,2"
                                                               Visibility="{Binding HasNativeCommand, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Run Text="Команда: " FontWeight="SemiBold" />
                                                        <Run Text="{Binding NativeCommandText, Mode=OneWay}" />
                                                    </TextBlock>

                                                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,2">
                                                        <Run Text="Последствия: " FontWeight="SemiBold" />
                                                        <Run Text="{Binding ConsequencesText, Mode=OneWay}" />
                                                    </TextBlock>

                                                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,2"
                                                               Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="Восстановление: " FontWeight="SemiBold" />
                                                        <Run Text="{Binding RestoreText, Mode=OneWay}" />
                                                    </TextBlock>

                                                    <TextBlock Text="{Binding ReasonText}"
                                                               Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibilityConverter}}"
                                                               TextWrapping="Wrap"
                                                               FontSize="12"
                                                               Foreground="{StaticResource WarningTextBrush}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding SizeText}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding RiskText}"
                                                               Margin="0,3,0,0"
                                                               FontSize="11"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{Binding Risk, Converter={StaticResource RiskBrushConverter}}" />
                                                    <TextBlock Text="{Binding ConsentText}"
                                                               Visibility="{Binding RequiresExplicitConsent, Converter={StaticResource BoolToVisibilityConverter}}"
                                                               Margin="0,3,0,0"
                                                               FontSize="11"
                                                               Foreground="{StaticResource WarningTextBrush}"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
