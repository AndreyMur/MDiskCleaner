    {
      "id": "docker-prune",
      "label": "Docker system prune",
      "group": "Docker",
      "category": "Cache",
      "risk": "Medium",
      "commandOnly": true,
      "cleanCommand": { "fileName": "docker", "arguments": "system prune -af", "timeoutSec": 600 },
      "description": "Неиспользуемые образы, контейнеры, сети и build-кэш Docker",
      "restoreHint": "download",
      "warning": "Удаляет неиспользуемые объекты Docker. Тома контейнеров не затрагиваются. Требуется запущенный Docker."
    }
