{
  "targets": [
    {
      "id": "npm-cache",
      "label": "npm cache",
      "group": "npm",
      "category": "Cache",
      "risk": "Low",
      "envPaths": [ "%LocalAppData%\\npm-cache" ],
      "pathQuery": { "fileName": "cmd.exe", "arguments": "/c npm config get cache", "timeoutSec": 20 },
      "configPathKey": "cache",
      "configFilePaths": [ "%USERPROFILE%\\.npmrc", "%APPDATA%\\npm\\etc\\npmrc" ],
      "cleanCommand": { "fileName": "cmd.exe", "arguments": "/c npm cache clean --force", "timeoutSec": 300 },
      "description": "Кэш пакетов npm (содержимое node_modules на установку)",
      "restoreHint": "download",
      "warning": "При следующей установке/сборке пакеты будут загружены заново (трафик и время). Осиротевший кэш прежней конфигурации удаляется напрямую."
    },
    {
      "id": "pnpm-store",
      "label": "pnpm store",
      "group": "pnpm",
      "category": "Cache",
      "risk": "Low",
      "envPaths": [ "%LocalAppData%\\pnpm-cache" ],
      "pathQuery": { "fileName": "cmd.exe", "arguments": "/c pnpm store path", "timeoutSec": 20 },
      "cleanCommand": { "fileName": "cmd.exe", "arguments": "/c pnpm store prune", "timeoutSec": 300 },
      "description": "Хранилище пакетов pnpm (store)",
      "restoreHint": "download",
      "warning": "Пакеты, не используемые проектами, будут загружены заново при необходимости."
    },
    {
      "id": "pip-cache",
      "label": "pip cache",
      "group": "pip",
      "category": "Cache",
      "risk": "Low",
      "envPaths": [ "%LocalAppData%\\pip\\cache", "%LocalAppData%\\pip\\Cache" ],
      "pathQuery": { "fileName": "cmd.exe", "arguments": "/c pip cache dir", "timeoutSec": 20 },
      "cleanCommand": { "fileName": "cmd.exe", "arguments": "/c pip cache purge", "timeoutSec": 180 },
      "description": "Кэш загруженных wheels пакетов pip",
      "restoreHint": "download",
      "warning": "При следующей установке пакеты будут скачаны повторно."
    },
    {
      "id": "uv-cache",
      "label": "uv cache",
      "group": "uv",
      "category": "Cache",
      "risk": "Low",
      "envPaths": [ "%LocalAppData%\\uv\\cache" ],
      "pathQuery": { "fileName": "cmd.exe", "arguments": "/c uv cache dir", "timeoutSec": 20 },
      "cleanCommand": { "fileName": "cmd.exe", "arguments": "/c uv cache clean", "timeoutSec": 180 },
      "description": "Кэш пакетов Python-менеджера uv",
      "restoreHint": "download",
      "warning": "При следующей установке пакеты будут скачаны повторно."
    },
    {
      "id": "dotslash-cache",
      "label": "dotslash cache",
      "group": "dotslash",
      "category": "Cache",
      "risk": "Low",
      "envPaths": [ "%UserProfile%\\.cache\\dotslash", "%LocalAppData%\\dotslash" ],
      "description": "Кэш загруженных инструментов dotslash",
      "restoreHint": "download",
      "warning": "Инструменты будут загружены повторно при вызове."
    },
    {
      "id": "gradle-caches",
      "label": "Gradle caches",
      "group": "Gradle",
      "category": "Cache",
      "risk": "Low",
      "envPaths": [ "%UserProfile%\\.gradle\\caches" ],
      "description": "Кэш зависимостей и артефактов сборки Gradle",
      "restoreHint": "download",
      "warning": "При следующей сборке зависимости будут скачаны заново."
    },
    {
      "id": "gradle-wrapper-dists",
      "label": "Gradle wrapper distributions",
      "group": "Gradle",
      "category": "Cache",
      "risk": "Low",
      "envPaths": [ "%UserProfile%\\.gradle\\wrapper\\dists" ],
      "description": "Загруженные дистрибутивы Gradle wrapper",
      "restoreHint": "download",
      "warning": "Дистрибутив Gradle будет загружен повторно при первом запуске wrapper."
    },
    {
      "id": "gradle-daemon",
      "label": "Gradle daemon logs",
      "group": "Gradle",
      "category": "Cache",
      "risk": "Low",
      "envPaths": [ "%UserProfile%\\.gradle\\daemon" ],
      "description": "Журналы и временные файлы фоновых процессов Gradle daemon",
      "restoreHint": "recreate",
      "warning": "Daemon пересоздаст файлы при следующем запуске сборки."
    },
    {
      "id": "gradle-jdks",
      "label": "Gradle JDK toolchains",
      "group": "Gradle",
      "category": "DevToolchain",
      "risk": "Medium",
      "consentLevel": "Ask",
      "envPaths": [ "%UserProfile%\\.gradle\\jdks" ],
      "description": "Автоматически установленные Gradle JDK (toolchains)",
      "restoreHint": "reinstall",
      "warning": "JDK будет установлен повторно при следующей сборке, требующей toolchain. Требует явного согласия."
    },
    {
      "id": "cargo-registry",
      "label": "Cargo registry",
      "group": "Cargo",
      "category": "Cache",
      "risk": "Low",
      "envPaths": [ "%UserProfile%\\.cargo\\registry" ],
      "description": "Кэш скачанных crates (registry) и их индексов",
      "restoreHint": "download",
      "warning": "Зависимости будут скачаны повторно при следующей сборке."
    },
    {
      "id": "cargo-git",
      "label": "Cargo git checkouts",
      "group": "Cargo",
      "category": "Cache",
      "risk": "Low",
      "envPaths": [ "%UserProfile%\\.cargo\\git" ],
      "description": "Git-зависимости Cargo (checkouts и кэш баз данных)",
      "restoreHint": "download",
      "warning": "Git-зависимости будут клонированы повторно при следующей сборке."
    },
    {
      "id": "rustup-toolchains",
      "label": "rustup toolchains",
      "group": "rustup",
      "category": "DevToolchain",
      "risk": "Medium",
      "consentLevel": "Ask",
      "envPaths": [ "%UserProfile%\\.rustup" ],
      "cleanCommand": { "fileName": "cmd.exe", "arguments": "/c rustup self uninstall -y", "timeoutSec": 600 },
      "description": "Тулчейны Rust, установленные через rustup",
      "restoreHint": "reinstall",
      "warning": "Требуется переустановка тулчейна (rustup toolchain install). Только с явного согласия."
    },
    {
      "id": "playwright-browsers",
      "label": "Playwright browsers",
      "group": "Playwright",
      "category": "Cache",
      "risk": "Low",
      "envPaths": [ "%LocalAppData%\\ms-playwright" ],
      "description": "Скачанные браузеры Playwright",
      "restoreHint": "reinstall",
      "warning": "Повторная установка: npx playwright install."
    },
    {
