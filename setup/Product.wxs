<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="DiskCleaner"
           Manufacturer="AndreyMur"
           Version="$(var.ProductVersion)"
           UpgradeCode="D85E3697-2D77-475B-8CD4-DEC02E7CF422"
           Language="1033"
           Scope="perMachine"
           InstallerVersion="500">

    <MajorUpgrade DowngradeErrorMessage="Более новая версия DiskCleaner уже установлена." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ProductIcon" SourceFile="..\src\DiskCleaner.Gui\Assets\DiskCleaner.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="ARPCOMMENTS" Value="Очистка диска, кэшей, остатков и ПО Windows" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DiskCleaner">
        <Component Id="AppFiles" Guid="758C5E5A-56BD-410F-BB22-DE0C835FA1E8">
          <File Id="MainExe"
                KeyPath="yes"
                Source="$(var.PublishDir)\DiskCleaner.exe" />
          <File Id="ElevatedExe"
                Source="$(var.PublishDir)\DiskCleaner.Elevated.exe" />
          <File Id="WpfNativeD3DCompiler"
                Source="$(var.PublishDir)\D3DCompiler_47_cor3.dll" />
          <File Id="WpfNativePenImc"
                Source="$(var.PublishDir)\PenImc_cor3.dll" />
          <File Id="WpfNativePresentation"
                Source="$(var.PublishDir)\PresentationNative_cor3.dll" />
          <File Id="WpfNativeVcruntime"
                Source="$(var.PublishDir)\vcruntime140_cor3.dll" />
          <File Id="WpfNativeWpfGfx"
                Source="$(var.PublishDir)\wpfgfx_cor3.dll" />
        </Component>
        <Component Id="StartMenuShortcut" Guid="8F2161BB-CEC8-4C6B-98C5-514FDB97CC89">
          <Shortcut Id="AppShortcut"
                    Directory="ProgramMenuFolder"
                    Name="DiskCleaner"
                    Description="Очистка диска и кэшей Windows"
                    Target="[INSTALLFOLDER]DiskCleaner.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU"
                         Key="Software\AndreyMur\DiskCleaner"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="ProductFeature" Title="DiskCleaner" Level="1">
      <ComponentRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>

</Wix>
